@echo off
chcp 65001 >nul
title Pizarra local
cd /d "%~dp0"
where node >nul 2>nul
if errorlevel 1 (
  echo.
  echo   Falta instalar Node.js.
  echo   Descargalo de https://nodejs.org ^(version LTS^), instalalo y volve a abrir este archivo.
  echo.
  start "" "https://nodejs.org"
  pause
  exit /b
)
rem Abre en el navegador por defecto. Para usar un perfil especifico de Firefox, reemplazar por:
rem start "" cmd /c "timeout /t 2 >NUL & start "" "%ProgramFiles%\Mozilla Firefox\firefox.exe" -no-remote -P "NOMBRE_DEL_PERFIL" http://localhost:3000"
start "" cmd /c "timeout /t 2 >NUL & start http://localhost:3000"
node servidor.js
pause
