@echo off
chcp 65001 >nul
title unzip.mat
cd /d "%~dp0"
where node >nul 2>nul
if errorlevel 1 (
  echo.
  echo   Falta instalar Node.js.
  echo   Descargalo de https://nodejs.org ^(version LTS^), instalalo y volve a abrir este archivo.
  echo.
  start "" "https://nodejs.org"
  pause
  exit /b
)
rem Crea una sesion compartida nueva y copia el link al portapapeles
for /f "delims=" %%L in ('node nueva-sesion.js') do set "LINK=%%L"
<nul set /p "=%LINK%" | clip
echo.
echo   Sesion compartida nueva:
echo   %LINK%
echo   El link ya esta copiado: pegalo en la otra ventana.
rem Abre la sesion en el navegador por defecto. Para abrirla ademas en un perfil especifico de Firefox, reemplazar por:
rem start "" cmd /c "timeout /t 2 >NUL & start "" "%LINK%" & timeout /t 1 >NUL & start "" "%ProgramFiles%\Mozilla Firefox\firefox.exe" -no-remote -P "NOMBRE_DEL_PERFIL" "%LINK%""
start "" cmd /c "timeout /t 2 >NUL & start "" "%LINK%""
node servidor.js
pause
